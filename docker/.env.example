# 抄成 .env 再填值；.env 不要提交
PAOTUI_MYSQL_ROOT_PASSWORD=change-me-root
PAOTUI_DB_PASSWORD=change-me-app
PAOTUI_ADMIN_PHONE=13800000000
PAOTUI_ADMIN_PASSWORD=change-me-first-login
# 首次发布后，将这两项替换为 GHCR 中公开的 v1.0 镜像
PAOTUI_BACKEND_IMAGE=ghcr.io/freext-94/maer-kuaipao-backend:v1.0.0
PAOTUI_WEB_IMAGE=ghcr.io/freext-94/maer-kuaipao-web:v1.0.0
# 对外端口（NAS 上把这个端口映射/穿透出去）
PAOTUI_HTTP_PORT=8088
